// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Enums

enum KategoriPeminjam {
  GURU
  SISWA
}

enum KategoriProduk {
  ASET
  HP // Habis Pakai
}

enum StatusPengajuan {
  DIAJUKAN
  DIPINJAM
  KEMBALI
  TERLAMBAT
}

enum StatusDetailProduk {
  TERSEDIA
  DIPINJAM
}

enum KondisiDetailProduk {
  BAIK
  RUSAK
}

// Models

model Admin {
  id       String @id @default(uuid())
  username String @unique @map("username") // VARCHAR 32
  password String @map("password") // VARCHAR 255

  sesi                 Sesi[]
  aktivitas            Aktivitas[]
  produk_diubah        Produk[]       @relation("ProdukDiubahOleh")
  lokasi_diubah        Lokasi[]       @relation("LokasiDiubahOleh")
  pengajuan_diubah     Pengajuan[]    @relation("PengajuanDiubahOleh")
  detail_produk_diubah DetailProduk[] @relation("DetailProdukDiubahOleh")

  @@map("tb_admin")
}

model Sesi {
  id                   String   @id @default(uuid())
  id_admin             String
  token                String   @map("token") // VARCHAR 255
  waktu_pembuatan      DateTime @default(now()) @map("waktu_pembuatan")
  waktu_akses_terakhir DateTime @updatedAt @map("waktu_akses_terakhir")
  waktu_kadaluarsa     DateTime @map("waktu_kadaluarsa")

  admin Admin @relation(fields: [id_admin], references: [id])

  @@map("tb_sesi")
}

model Peminjam {
  id          String           @id @default(uuid())
  kategori    KategoriPeminjam
  nama        String           @map("nama") // VARCHAR 100
  nomor_induk String           @unique @map("nomor_induk") // VARCHAR 23
  kelas       String?          @map("kelas") // VARCHAR 12, BOLEH NULL

  pengajuan Pengajuan[]
  aktivitas Aktivitas[]

  @@map("tb_peminjam")
}

model Pengajuan {
  id              String          @id @default(uuid())
  status          StatusPengajuan
  id_peminjam     String
  catatan         String          @map("catatan") // VARCHAR 255
  tanggal_pinjam  DateTime        @default(now()) @map("tanggal_pinjam")
  tanggal_kembali DateTime?       @map("tanggal_kembali")
  kode_resi       String          @map("kode_resi") // VARCHAR 12
  waktu_dibuat    DateTime        @default(now()) @map("waktu_dibuat")
  waktu_diubah    DateTime        @updatedAt @map("waktu_diubah")
  id_diubah_oleh  String?         @map("diubah_oleh")

  peminjam         Peminjam          @relation(fields: [id_peminjam], references: [id])
  diubah_oleh      Admin?            @relation("PengajuanDiubahOleh", fields: [id_diubah_oleh], references: [id])
  detail_pengajuan DetailPengajuan[]

  @@map("tb_pengajuan")
}

model Produk {
  id             Int            @id @default(autoincrement())
  kategori       KategoriProduk
  nama           String         @map("nama") // VARCHAR 50
  kode           String         @map("kode") // VARCHAR 32
  merk           String         @map("merk") // VARCHAR 50
  model          String         @map("model") // VARCHAR 50
  spesifikasi    String         @map("spesifikasi") // VARCHAR 100
  kuantitas      Int            @default(0) @map("kuantitas") // SMALL INT
  waktu_dibuat   DateTime       @default(now()) @map("waktu_dibuat")
  waktu_diubah   DateTime       @updatedAt @map("waktu_diubah")
  id_diubah_oleh String?        @map("diubah_oleh")

  diubah_oleh      Admin?            @relation("ProdukDiubahOleh", fields: [id_diubah_oleh], references: [id])
  detail_produk    DetailProduk[]
  detail_pengajuan DetailPengajuan[]

  @@map("tb_produk")
}

model DetailProduk {
  id             Int                 @id @default(autoincrement())
  id_produk      Int
  id_lokasi      Int
  status         StatusDetailProduk
  kondisi        KondisiDetailProduk
  kode_seri      String?             @map("kode_seri")
  kode_scan      String?             @map("kode_scan")
  waktu_dibuat   DateTime            @default(now()) @map("waktu_dibuat")
  waktu_diubah   DateTime            @updatedAt @map("waktu_diubah")
  id_diubah_oleh String?             @map("diubah_oleh")

  produk                  Produk                  @relation(fields: [id_produk], references: [id])
  lokasi                  Lokasi                  @relation(fields: [id_lokasi], references: [id])
  diubah_oleh             Admin?                  @relation("DetailProdukDiubahOleh", fields: [id_diubah_oleh], references: [id])
  detail_produk_pengajuan DetailProdukPengajuan[]

  @@map("tb_detail_produk")
}

model Lokasi {
  id             Int      @id @default(autoincrement())
  nama_ruang     String   @map("nama_ruang") // VARCHAR 30
  keterangan     String   @map("keterangan") // VARCHAR 50
  waktu_dibuat   DateTime @default(now()) @map("waktu_dibuat")
  waktu_diubah   DateTime @updatedAt @map("waktu_diubah")
  id_diubah_oleh String?  @map("diubah_oleh")

  diubah_oleh   Admin?         @relation("LokasiDiubahOleh", fields: [id_diubah_oleh], references: [id])
  detail_produk DetailProduk[]

  @@map("tb_lokasi")
}

model DetailPengajuan {
  id           String @id @default(uuid())
  id_pengajuan String
  id_produk    Int
  kuantitas    Int    @map("kuantitas") // SMALL INT

  pengajuan               Pengajuan               @relation(fields: [id_pengajuan], references: [id])
  produk                  Produk                  @relation(fields: [id_produk], references: [id])
  detail_produk_pengajuan DetailProdukPengajuan[]

  @@map("tb_detail_pengajuan")
}

model DetailProdukPengajuan {
  id                  String @id @default(uuid())
  id_detail_pengajuan String
  id_detail_produk    Int

  detail_pengajuan DetailPengajuan @relation(fields: [id_detail_pengajuan], references: [id])
  detail_produk    DetailProduk    @relation(fields: [id_detail_produk], references: [id])

  @@map("tb_detail_produk_pengajuan")
}

model Aktivitas {
  id          String   @id @default(uuid())
  waktu       DateTime @map("waktu")
  kategori    String   @map("kategori")
  keterangan  String   @map("keterangan")
  id_admin    String?
  id_peminjam String?

  admin    Admin?    @relation(fields: [id_admin], references: [id])
  peminjam Peminjam? @relation(fields: [id_peminjam], references: [id])

  @@map("tb_aktivitas")
}
