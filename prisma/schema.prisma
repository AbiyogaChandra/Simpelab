// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Enums

enum KategoriPeminjam {
  GURU
  SISWA
}

enum KategoriProduk {
  ASET
  HP // Habis Pakai
}

enum StatusPengajuan {
  DIAJUKAN
  DIPINJAM
  KEMBALI
  TERLAMBAT
}

enum StatusDetailProduk {
  TERSEDIA
  DIPINJAM
}

enum KondisiDetailProduk {
  BAIK
  RUSAK
}

// Models

model Admin {
  id       String @id @default(uuid())
  username String @unique // VARCHAR 32
  password String // VARCHAR 255

  session              Session[]
  aktivitas            Aktivitas[]
  produk_diubah        Produk[]       @relation("ProdukDiubahOleh")
  lokasi_diubah        Lokasi[]       @relation("LokasiDiubahOleh")
  pengajuan_diubah     Pengajuan[]    @relation("PengajuanDiubahOleh")
  detail_produk_diubah DetailProduk[] @relation("DetailProdukDiubahOleh")
}

model Session {
  id               String   @id @default(uuid())
  id_admin         String
  token            String // VARCHAR 255
  created_at       DateTime @default(now())
  last_accessed_at DateTime @updatedAt
  expires_at       DateTime

  admin Admin @relation(fields: [id_admin], references: [id])
}

model Peminjam {
  id          String           @id @default(uuid())
  kategori    KategoriPeminjam
  nama        String // VARCHAR 100
  nomor_induk String           @unique // VARCHAR 23
  kelas       String? // VARCHAR 12, BOLEH NULL

  pengajuan Pengajuan[]
  aktivitas Aktivitas[]
}

model Pengajuan {
  id              String          @id @default(uuid())
  status          StatusPengajuan
  id_peminjam     String
  catatan         String // VARCHAR 255
  tanggal_pinjam  DateTime        @default(now())
  tanggal_kembali DateTime?
  kode_resi       String // VARCHAR 12
  foto            String?
  waktu_dibuat    DateTime        @default(now())
  waktu_diubah    DateTime        @updatedAt
  id_diubah_oleh  String?

  peminjam         Peminjam          @relation(fields: [id_peminjam], references: [id])
  diubah_oleh      Admin?            @relation("PengajuanDiubahOleh", fields: [id_diubah_oleh], references: [id])
  detail_pengajuan DetailPengajuan[]
}

model Produk {
  id             Int            @id @default(autoincrement())
  kategori       KategoriProduk
  nama           String // VARCHAR 50
  kode           String // VARCHAR 10
  merk           String // VARCHAR 50
  model          String // VARCHAR 50
  spesifikasi    String // VARCHAR 100
  kuantitas      Int            @default(0) // SMALL INT
  waktu_dibuat   DateTime       @default(now())
  waktu_diubah   DateTime       @updatedAt
  id_diubah_oleh String?

  diubah_oleh      Admin?            @relation("ProdukDiubahOleh", fields: [id_diubah_oleh], references: [id])
  detail_produk    DetailProduk[]
  detail_pengajuan DetailPengajuan[]
}

model DetailProduk {
  id             Int                 @id @default(autoincrement())
  id_produk      Int
  id_lokasi      Int
  status         StatusDetailProduk
  kondisi        KondisiDetailProduk
  kode_seri      String?
  kode_scan      String?
  foto           String?
  waktu_dibuat   DateTime            @default(now())
  waktu_diubah   DateTime            @updatedAt
  id_diubah_oleh String?

  produk                  Produk                  @relation(fields: [id_produk], references: [id])
  lokasi                  Lokasi                  @relation(fields: [id_lokasi], references: [id])
  diubah_oleh             Admin?                  @relation("DetailProdukDiubahOleh", fields: [id_diubah_oleh], references: [id])
  detail_produk_pengajuan DetailProdukPengajuan[]
}

model Lokasi {
  id             Int      @id @default(autoincrement())
  nama_ruang     String // VARCHAR 30
  keterangan     String // VARCHAR 50
  waktu_dibuat   DateTime @default(now())
  waktu_diubah   DateTime @updatedAt
  id_diubah_oleh String?

  diubah_oleh   Admin?         @relation("LokasiDiubahOleh", fields: [id_diubah_oleh], references: [id])
  detail_produk DetailProduk[]
}

model DetailPengajuan {
  id           String @id @default(uuid())
  id_pengajuan String
  id_produk    Int
  kuantitas    Int // SMALL INT

  pengajuan               Pengajuan               @relation(fields: [id_pengajuan], references: [id])
  produk                  Produk                  @relation(fields: [id_produk], references: [id])
  detail_produk_pengajuan DetailProdukPengajuan[]
}

model DetailProdukPengajuan {
  id                  String @id @default(uuid())
  id_detail_pengajuan String
  id_detail_produk    Int

  detail_pengajuan DetailPengajuan @relation(fields: [id_detail_pengajuan], references: [id])
  detail_produk    DetailProduk    @relation(fields: [id_detail_produk], references: [id])
}

model Aktivitas {
  id          String   @id @default(uuid())
  waktu       DateTime
  kategori    String
  keterangan  String
  id_admin    String?
  id_peminjam String?

  admin    Admin?    @relation(fields: [id_admin], references: [id])
  peminjam Peminjam? @relation(fields: [id_peminjam], references: [id])
}
